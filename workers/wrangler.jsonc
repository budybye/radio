{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "radio",
  "main": "./worker/index.ts",
  "workers_dev": false,
  "compatibility_date": "2026-04-04",
  "compatibility_flags": ["nodejs_compat"],
  "placement": { "region": "gcp:asia-northeast1" },
  "observability": { "enabled": true },
  "route": {
    "pattern": "044g.com",
    "custom_domain": true,
  },
  "durable_objects": {
    "bindings": [{ "name": "MpdAgent", "class_name": "MpdAgent" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["MpdAgent"] }]
}

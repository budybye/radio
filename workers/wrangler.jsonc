{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Single Worker "radio" → radio.*.workers.dev (+ optional custom domain in dashboard).
  "name": "radio",
  "main": "./worker/index.ts",
  "workers_dev": true,
  "compatibility_date": "2026-08-21",
  // "compatibility_flags": ["nodejs_compat"],
  "placement": { "region": "gcp:asia-northeast1" },
  "observability": { "enabled": true },
  "durable_objects": {
    "bindings": [
      { "name": "MpdAgent", "class_name": "MpdAgent" }
    ]
  },
  "migrations": [
  	{ "tag": "v1", 
   	  "new_sqlite_classes": ["MpdAgent"] 
   	}
  ],
}

{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Default env: fork-friendly (Deploy to Cloudflare). Replace vars with your Tunnel hostnames.
  "name": "radio",
  "main": "./worker/index.ts",
  "workers_dev": true,
  "compatibility_date": "2026-08-21",
  // "compatibility_flags": ["nodejs_compat"],
  "placement": { "region": "gcp:asia-northeast1" },
  "observability": { "enabled": true },
  "durable_objects": {
    "bindings": [{ "name": "MpdAgent", "class_name": "MpdAgent" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["MpdAgent"] }],
  "vars": {
    "MPD_HOST": "mpd.example.com",
    "MPC_HOST": "mpc.example.com"
  },
  "env": {
    // Maintainer production — same Worker name "radio" as custom domain binding.
    // Hostnames come from root .env.production via deploy.sh (--var injection).
    "production": {
      "name": "radio",
      "workers_dev": false,
      "vars": {
        "MPD_HOST": "mpd.example.com",
        "MPC_HOST": "mpc.example.com"
      },
      "durable_objects": {
        "bindings": [{ "name": "MpdAgent", "class_name": "MpdAgent" }]
      }
    },
    // Isolated preview Worker for E2E — never touches production routes.
    "preview": {
      "name": "radio-preview",
      "workers_dev": true,
      "vars": {
        "MPD_HOST": "mpd.example.com",
        "MPC_HOST": "e2e-dummy"
      },
      "durable_objects": {
        "bindings": [{ "name": "MpdAgent", "class_name": "MpdAgent" }]
      }
    }
  }
}

# workers/.env — copy to .env (gitignored)
# 詳細: docs/deploy-fork.md#env-files

# --- Deploy vars (bun run deploy → wrangler --var) ---
MPD_HOST=mpd.your-domain.com
MPC_HOST=mpc.your-domain.com

# --- Secrets (bun run dev, wrangler secret bulk) ---
# CF_ACCESS: Zero Trust → Access → Service Auth → Service Tokens
CF_ACCESS_CLIENT_ID=
CF_ACCESS_CLIENT_SECRET=

# Admin UI (Basic Auth) — openssl rand -hex 16
USERNAME=admin
PASSWORD=

# Queue API write (optional) — openssl rand -hex 32
TOKEN=

# --- Local dev only: mpd-stub instead of real mpc-bridge ---
# MPC_BRIDGE_BASE_URL=http://127.0.0.1:18080

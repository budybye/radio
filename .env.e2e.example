# E2E tier matrix — see docs/test.md
# NOT used for deploy. See docs/deploy-fork.md#env-files

# --- local: vp dev + mpd-stub ---
# RADIO_E2E_TIER=local
# RADIO_E2E_BASE_URL=http://127.0.0.1:5173

# --- preview: radio-preview Worker (structural smoke only) ---
# RADIO_E2E_TIER=preview
# RADIO_E2E_PREVIEW_URL=https://radio-preview.<account>.workers.dev
# Deploy preview first: cd workers && bun run deploy:preview

# --- prod: custom domain read-only smoke ---
# RADIO_E2E_TIER=prod
# RADIO_E2E_ALLOW_PROD=1
# RADIO_E2E_PROD_URL=https://your-domain.com

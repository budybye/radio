# E2E tier matrix — see docs/test.md
# デプロイ用ではない。詳細: docs/deploy-fork.md#env-files
# ┌─────────┬──────────────────────┬─────────────────┬──────────────────────────────┐
# │ tier    │ URL                  │ MPD backend     │ fixture 値を検証するか       │
# ├─────────┼──────────────────────┼─────────────────┼──────────────────────────────┤
# │ local   │ http://127.0.0.1:5173│ mpd-stub :18080 │ YES (contract.json 正本)     │
# │ preview │ *.workers.dev        │ 本番 or 未設定  │ NO（構造マーカーのみ）       │
# │ prod    │ your custom domain   │ 本番 MPD        │ NO（GET / 200 のみ）         │
# └─────────┴──────────────────────┴─────────────────┴──────────────────────────────┘

# --- local (default): loopback vp dev + mpd-stub ---
RADIO_E2E_TIER=local
RADIO_E2E_BASE_URL=http://127.0.0.1:5173

# --- preview: workers.dev deploy (structural smoke only) ---
# RADIO_E2E_TIER=preview
# RADIO_E2E_PREVIEW_URL=https://radio-production.<account>.workers.dev
#   # フォーク既定 deploy なら radio.<account>.workers.dev

# --- prod: explicit opt-in, read-only GET / only ---
# RADIO_E2E_TIER=prod
# RADIO_E2E_ALLOW_PROD=1
# RADIO_E2E_PROD_URL=https://your-domain.com

# opencli session tuning
# RADIO_E2E_OPENCLI_SESSION=radio-e2e
# RADIO_E2E_OPENCLI_WINDOW=background

# mpd-stub (local only)
# MPD_STUB_PORT=18080
# workers/.dev.vars: MPC_BRIDGE_BASE_URL=http://127.0.0.1:18080

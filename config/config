ncmpcpp_directory = /root/.ncmpcpp
mpd_host = localhost
mpd_port = 6600
mpd_music_dir = /music
mpd_connection_timeout = 5
mpd_crossfade_time = 5

# Display
song_columns_list_format = (40)[yellow]{t|f:Title} (30)[green]{a} (30)[magenta]{b} (7f)[blue]{l}
song_list_format = "{[%l]}{%t }$R{%a - %b}"
song_status_format = "{%a - }{%t - }{%b}"
now_playing_prefix = "$b$8"
now_playing_suffix = "$/b$9"
autocenter_mode = yes
centered_cursor = yes
mouse_support = yes

# Audio

# Colors
colors_enabled = yes
empty_tag_color = cyan
volume_color = cyan
state_line_color = black
state_flags_color = magenta
main_window_color = yellow
color1 = white
color2 = black
current_item_prefix = "$(yellow)$r"
current_item_suffix = "$/r$(end)"
progressbar_color = red
current_item_inactive_column_prefix = "$(white)$r"
current_item_inactive_column_suffix = "$/r$(end)"

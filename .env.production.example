# Maintainer production — copy to .env.production (gitignored)
#
# Used by: cd workers && bun run deploy
#           → scripts/deploy.sh production
#
# NOT the same as wrangler.jsonc "env.production" (Wrangler environment name).
# See docs/deploy-fork.md#env-files

MPD_HOST=mpd.your-domain.com
MPC_HOST=mpc.your-domain.com

# Optional — E2E smoke URLs
# RADIO_E2E_PROD_URL=https://your-domain.com
# RADIO_E2E_PREVIEW_URL=https://radio-preview.<account>.workers.dev

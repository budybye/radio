# メンテナ本番 deploy 用 — copy to .env.production (gitignored)
#
# 用途: cd workers && bun run deploy
#       → deploy-production.sh が source し、MPD_HOST / MPC_HOST を wrangler --var で注入
#
# 注意: これは「シェル用 .env.production」。
#       wrangler.jsonc の env.production（Wrangler 環境名）とは別物。
# 詳細: docs/deploy-fork.md#env-files

MPD_HOST=mpd.your-domain.com
MPC_HOST=mpc.your-domain.com

# 任意: make test-e2e-prod が参照
# RADIO_E2E_PROD_URL=https://your-domain.com
